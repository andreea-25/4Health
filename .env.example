# Copiază acest fișier în .env și modifică valorile.

# PostgreSQL (instalat pe Windows sau pornit cu docker compose up -d db)
DATABASE_URL=postgresql+psycopg://health4:health4@localhost:5432/health4

# python   = merge cu orice PostgreSQL (embeddings salvate ca JSON, similaritate calculată în Python)
# pgvector = căutare vectorială în SQL; necesită extensia pgvector (inclusă în imaginea Docker)
VECTOR_BACKEND=python

# Generează un secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=schimba-ma-cu-un-secret-lung-si-aleator
DOCTOR_INVITE_CODE=DOCTOR-2026

# Ollama (rulează local pe Windows)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
# bge-m3 = multilingv (bun pe română), 1024 dimensiuni.
# Dacă schimbi modelul de embedding, schimbă și EMBED_DIM și rulează: python -m app.seed --reset
EMBED_MODEL=bge-m3
EMBED_DIM=1024
LLM_NUM_CTX=4096
RAG_MIN_SCORE=0.45
